#!/bin/sh

set -e

onie_platform="$(sed -n 's/^[[:space:]]*onie_platform[[:space:]]*=[[:space:]]*//p' /host/machine.conf)"

if [ -z "$onie_platform" ]; then
    echo "Warning: onie_platform variable not set"
    exit 1
fi

# Merge optional platform FEATURE overrides into init_cfg.json. The
# device-specific document is the right-hand side, so its values win while
# fields it does not mention retain their image defaults.
INIT_CFG="/etc/sonic/init_cfg.json"
DEVICE_INIT_CFG="/usr/share/sonic/device/$onie_platform/init_cfg.json"
if [ -f "$INIT_CFG" ] && [ -f "$DEVICE_INIT_CFG" ]; then
    if ! command -v jq >/dev/null 2>&1; then
        echo "Warning: jq not found, skipping merge of $DEVICE_INIT_CFG into $INIT_CFG" >&2
    elif merged=$(jq -s '.[0] * .[1]' "$INIT_CFG" "$DEVICE_INIT_CFG") && [ -n "$merged" ]; then
        tmp=$(mktemp -p /etc/sonic init_cfg.XXXXXX)
        printf '%s\n' "$merged" > "$tmp"
        chmod "$(stat -c %a "$INIT_CFG")" "$tmp"
        mv "$tmp" "$INIT_CFG"
        echo "Merged platform FEATURE defaults from $DEVICE_INIT_CFG into $INIT_CFG"
    else
        echo "Warning: failed to merge $DEVICE_INIT_CFG into $INIT_CFG" >&2
    fi
fi

depmod -a

pywhl="/usr/share/sonic/device/$onie_platform/sonic_platform-1.0-py3-none-any.whl"
if [ ! -f "$pywhl" ]; then
    cp /usr/share/sonic/device/x86_64-arista_common/*.whl  \
        "/usr/share/sonic/device/$onie_platform"
fi

if pip3 show sonic_platform > /dev/null 2>&1; then
    pip3 uninstall --root-user-action=ignore --yes sonic_platform
fi
pip3 install --root-user-action=ignore --no-deps "$pywhl"

systemctl daemon-reload

svcs="$(grep /lib/systemd/system/platform-arista \
    /var/lib/dpkg/info/sonic-platform-arista-all.list  | sed 's/.*\///')"

for svc in $svcs; do
    systemctl enable "$svc"
done

# Enable and start the firmware upgrade service immediately before starting
# other Arista services.
if [ -f /var/lib/dpkg/info/arista-fwutil.list ]; then
    svcs="$(grep /lib/systemd/system/platform-arista \
        /var/lib/dpkg/info/arista-fwutil.list  | sed 's/.*\///')"
    for svc in $svcs; do
        systemctl enable "$svc"
    done
fi

systemctl start --no-block platform-arista.target

exit 0
